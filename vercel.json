{
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(self \"https://forms.acom.com.ve\")"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://www.facebook.com https://*.facebook.com https://catalogos.acomve.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://www.facebook.com https://connect.facebook.net https://vitals.vercel-insights.com https://*.vercel-insights.com https://www.zentralapp.ai; frame-src https://forms.acom.com.ve https://challenges.cloudflare.com; form-action 'self' https://forms.acom.com.ve"
                },
                {
                    "key": "Vary",
                    "value": "Accept"
                }
            ]
        },
        {
            "source": "/images/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/linea-credito",
            "destination": "/como-trabajamos",
            "permanent": true
        },
        {
            "source": "/privacy",
            "destination": "/politica-de-privacidad",
            "permanent": false
        },
        {
            "source": "/privacidad",
            "destination": "/politica-de-privacidad",
            "permanent": false
        },
        {
            "source": "/about",
            "destination": "/sobre-acom",
            "permanent": false
        },
        {
            "source": "/contact",
            "destination": "/contacto",
            "permanent": false
        },
        {
            "source": "/terms",
            "destination": "/terminos-y-condiciones",
            "permanent": false
        },
        {
            "source": "/faq",
            "destination": "/preguntas-frecuentes",
            "permanent": false
        }
    ],
    "routes": [
        {
            "src": "/",
            "has": [
                {
                    "type": "header",
                    "key": "accept",
                    "value": ".*text/markdown.*"
                }
            ],
            "missing": [
                {
                    "type": "header",
                    "key": "accept",
                    "value": ".*text/markdown *; *q=0(\\.0+)?([,;].*)?"
                }
